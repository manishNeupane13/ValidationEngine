SAMSARA_API_TOKEN=replace_me
SAMSARA_BASE_URL=https://api.samsara.com
POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=20
MAX_ATTEMPTS=4
CONCURRENCY=5
REQUESTS_PER_SECOND=5
VEHICLE_PAGE_SIZE=512
# Keep at 1 until multi-ID batching is verified for the exact endpoint/version.
VEHICLE_BATCH_SIZE=1
SAMSARA_STATS_TYPES=engineStates
OUTPUT_DIR=./data

# Dynamic integration platform (separate from the poller)
INTEGRATION_DATA_DIR=./integration-data
INTEGRATION_API_URL=http://127.0.0.1:8000
INTEGRATION_HOST=127.0.0.1
INTEGRATION_PORT=8000
INTEGRATION_MAX_UPLOAD_MB=50

# HTTP GET connections. Configure trusted API hostnames and bearer secrets in the API process.
INTEGRATION_HTTP_ALLOWED_HOSTS=api.samsara.com
# INTEGRATION_HTTP_TOKEN_FLEET=replace_me
# Optional public URL for a proxy that exposes the webhook receiver.
# INTEGRATION_WEBHOOK_BASE_URL=https://hooks.example.com
